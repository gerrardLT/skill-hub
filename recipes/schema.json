{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-hub.local/recipes/schema.json",
  "title": "Capability Compiler Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "description", "inputs", "outputs", "permissions", "steps", "edges", "gates", "failure_routes", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "released"},
    "description": {"type": "string", "minLength": 1},
    "inputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "outputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "permissions": {"$ref": "#/$defs/nonEmptyStrings"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slot", "ref", "input_map", "output_map", "depends_on", "gates", "permissions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "slot": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "ref": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "input_map": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
          "output_map": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "gates": {"$ref": "#/$defs/nonEmptyStrings"},
          "permissions": {"$ref": "#/$defs/nonEmptyStrings"}
        }
      }
    },
    "edges": {"type": "array", "items": {"$ref": "#/$defs/route"}, "uniqueItems": true},
    "gates": {"$ref": "#/$defs/nonEmptyStrings"},
    "failure_routes": {"type": "array", "items": {"$ref": "#/$defs/failureRoute"}},
    "evidence": {"$ref": "#/$defs/evidence"}
  },
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}}
    },
    "failureRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "on_status", "action"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "on_status": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["needs-input", "failed", "blocked"]}},
        "action": {"enum": ["stop", "record-and-return", "invalidate-and-rerun"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition_runs", "review"],
      "properties": {
        "composition_runs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceFile"}},
        "review": {"$ref": "#/$defs/evidenceFile"}
      }
    },
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
