      ],
      "action": "stop"
    },
    {
      "from": "implement",
      "to": "implement",
      "on_status": [
        "failed"
      ],
      "action": "record-and-return"
    },
    {
      "from": "implement",
      "to": "implement",
      "on_status": [
        "blocked"
      ],
      "action": "record-and-return"
    },
    {
      "from": "complete",
      "to": "complete",
      "on_status": [
        "needs-input"
      ],
      "action": "stop"
    },
    {
      "from": "complete",
      "to": "implement",
      "on_status": [
        "failed"
      ],
      "action": "invalidate-and-rerun"
    },
    {
      "from": "complete",
      "to": "complete",
      "on_status": [
        "blocked"
      ],
      "action": "record-and-return"
    }
  ],
  "feedback_mappings": [
    {
      "from_step": "complete",
      "to_step": "implement",
