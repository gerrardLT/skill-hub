    "ls",
    "bash",
    "edit",
    "write",
    "run-tests"
  ],
  "steps": [
    {
      "id": "implement",
      "slot": "tdd-change-loop",
      "ref": "tdd-change-loop@1.0.0",
      "input_map": {
        "requirements-artifact": "requirements-artifact",
        "acceptance-criteria-artifact": "acceptance-criteria-artifact",
        "design-contract": "design-contract",
        "repository-context": "repository-context",
        "execution-authorization": "execution-authorization",
        "Correction feedback": "Correction feedback"
      },
      "output_map": {
        "change-artifact": "change-artifact"
      },
      "depends_on": [],
      "gates": [
        "evidence-present",
        "unknowns-preserved",
        "authority-boundary",
        "responsibility-boundary"
      ],
      "permissions": [
        "read",
        "grep",
        "find",
        "ls",
        "bash",
        "edit",
        "write",
        "run-tests"
      ],
      "execution_adapter": "workspace"
    },
    {
      "id": "complete",
      "slot": "completion-evidence-gate",
      "ref": "completion-evidence-gate@1.0.0",
      "input_map": {
        "change-artifact": "change-artifact",
        "acceptance-criteria-artifact": "acceptance-criteria-artifact",
        "repository-context": "repository-context"
      },
      "output_map": {
        "completion-evidence": "completion-evidence"
      },
      "depends_on": [
        "implement"
      ],
      "gates": [
        "evidence-present",
        "unknowns-preserved",
        "authority-boundary",
        "responsibility-boundary"
      ],
      "permissions": [
        "read",
        "grep",
        "find",
        "ls",
        "bash",
        "run-tests"
      ],
      "execution_adapter": "workspace"
    }
  ],
  "edges": [
    {
      "from": "implement",
      "to": "complete"
    }
  ],
  "gates": [
    "evidence-present",
    "unknowns-preserved",
    "authority-boundary",
    "responsibility-boundary"
  ],
  "failure_routes": [
    {
      "from": "implement",
      "to": "implement",
