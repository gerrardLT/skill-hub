{
  "version": "2.1.0",
  "factors": {
    "blast_radius": {
      "weight": 1.5,
      "description": "Users, systems and data affected by failure"
    },
    "data_sensitivity": {
      "weight": 1.8,
      "description": "Sensitivity of personal, financial or confidential data"
    },
    "regulatory_exposure": {
      "weight": 1.8,
      "description": "Regulatory and contractual obligations"
    },
    "irreversibility": {
      "weight": 1.6,
      "description": "Difficulty of rollback or remediation"
    },
    "technical_novelty": {
      "weight": 1.0,
      "description": "Novel stack, architecture or integration"
    },
    "problem_uncertainty": {
      "weight": 1.1,
      "description": "Uncertainty in user problem and expected outcome"
    },
    "user_exposure": {
      "weight": 1.2,
      "description": "External user and revenue exposure"
    },
    "change_size": {
      "weight": 0.8,
      "description": "Scope and coupling of the change"
    },
    "operational_complexity": {
      "weight": 1.2,
      "description": "Deployment, migration and runtime complexity"
    }
  },
  "thresholds": {
    "lite_max": 13.0,
    "standard_max": 27.0
  },
  "hard_escalations": [
    {
      "factor": "data_sensitivity",
      "minimum": 5,
      "profile": "high-assurance"
    },
    {
      "factor": "regulatory_exposure",
      "minimum": 4,
      "profile": "high-assurance"
    },
    {
      "factor": "irreversibility",
      "minimum": 5,
      "profile": "high-assurance"
    },
    {
      "factor": "blast_radius",
      "minimum": 5,
      "profile": "high-assurance"
    }
  ],
  "profiles": {
    "lite": {
      "minimum_independent_reviewers": 0,
      "required_controls": [
        "state-integrity",
        "risk-register",
        "rollback-note",
        "basic-tests"
      ],
      "optional_controls": [
        "formal-threat-model",
        "load-test",
        "canary-release"
      ]
    },
    "standard": {
      "minimum_independent_reviewers": 1,
      "required_controls": [
        "state-integrity",
        "evidence-ledger",
        "traceability",
        "code-review",
        "automated-tests",
        "rollback-plan",
        "runtime-observability"
      ],
      "optional_controls": [
        "formal-threat-model",
        "migration-rehearsal",
        "chaos-test"
      ]
    },
    "high-assurance": {
      "minimum_independent_reviewers": 2,
      "required_controls": [
        "state-integrity",
        "independent-evidence-review",
        "complete-traceability",
        "threat-model",
        "privacy-review",
        "security-tests",
        "performance-tests",
        "migration-rehearsal",
        "canary-release",
        "tested-rollback",
        "audit-retention",
        "incident-runbook"
      ],
      "optional_controls": []
    }
  }
}
