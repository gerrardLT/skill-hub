{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic SDLC Evidence Record",
  "type": "object",
  "required": [
    "id",
    "claim",
    "source",
    "source_type",
    "quality",
    "supports",
    "observed_at",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "primary",
        "official",
        "user-research",
        "telemetry",
        "experiment",
        "test",
        "audit",
        "code",
        "incident",
        "secondary",
        "opinion",
        "other"
      ]
    },
    "method": {
      "type": "string"
    },
    "observed_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
