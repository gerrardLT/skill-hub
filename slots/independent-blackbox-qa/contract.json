{
  "artifact_types": [
    "SKILL.md",
    "contract.json",
    "provenance.json"
  ],
  "boundaries": {
    "input": "An accessible application, change scope, QA mode, and authorized interaction boundary.",
    "output": "Report-only defects, screenshots, console evidence, and a health score; never a product-code repair."
  },
  "dependencies": [],
  "forbidden_actions": [
    "claim purification or release",
    "execute without required permissions and evidence",
    "fabricate or infer missing evidence"
  ],
  "gates": [
    "evidence-present",
    "unknowns-preserved",
    "authority-boundary",
    "responsibility-boundary"
  ],
  "hard_failures": [
    "missing-source-evidence",
    "missing-required-permission",
    "unresolved-dependency",
    "fabricated-evidence",
    "incorrect-gate-pass"
  ],
  "id": "independent-blackbox-qa",
  "inputs": [
    "requirements-artifact",
    "acceptance-criteria-artifact",
    "design-contract",
    "change-artifact",
    "qa-authorization",
    "Correction feedback"
  ],
  "outputs": [
    "qa-verdict"
  ],
  "permissions": {
    "default": [
      "read",
      "grep",
      "find",
      "ls",
      "bash",
      "run-tests",
      "browser-readonly"
    ],
    "requires_explicit_authorization": false,
    "explicitly_denied": [
      "remote-git",
      "network",
      "merge",
      "deploy"
    ]
  },
  "responsibility": "Run diff-aware, quick, or regression black-box QA without modifying product source.",
  "schema_version": "1.0",
  "status": "released",
  "statuses": [
    "passed",
    "failed",
    "needs-input",
    "blocked"
  ],
  "version": "1.0.0",
  "execution": {
    "adapter": "workspace",
    "tools": [
      "read",
      "grep",
      "find",
      "ls",
      "bash",
      "run-tests",
      "browser-readonly"
    ],
    "mutation": "none",
    "authorization": {
      "required": false,
      "scopes": []
    },
    "correction_inputs": [
      "Correction feedback"
    ]
  }
}
