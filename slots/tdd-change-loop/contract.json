{
  "artifact_types": [
    "SKILL.md",
    "contract.json",
    "provenance.json"
  ],
  "boundaries": {
    "input": "A feature, defect, refactor, or other behavior change.",
    "output": "Minimal code supported by observed RED, GREEN, cleanup, and completion evidence."
  },
  "dependencies": [],
  "forbidden_actions": [
    "claim purification or release",
    "execute without required permissions and evidence",
    "fabricate or infer missing evidence"
  ],
  "gates": [
    "evidence-present",
    "unknowns-preserved",
    "authority-boundary",
    "responsibility-boundary"
  ],
  "hard_failures": [
    "missing-source-evidence",
    "missing-required-permission",
    "unresolved-dependency",
    "fabricated-evidence",
    "incorrect-gate-pass"
  ],
  "id": "tdd-change-loop",
  "inputs": [
    "requirements-artifact",
    "acceptance-criteria-artifact",
    "design-contract",
    "repository-context",
    "execution-authorization",
    "Correction feedback"
  ],
  "outputs": [
    "change-artifact"
  ],
  "permissions": {
    "default": [
      "read",
      "grep",
      "find",
      "ls",
      "bash",
      "edit",
      "write",
      "run-tests"
    ],
    "requires_explicit_authorization": true,
    "explicitly_denied": [
      "remote-git",
      "network",
      "merge",
      "deploy"
    ]
  },
  "responsibility": "Drive behavior changes through a real red-green-refactor loop and a final fresh verification.",
  "schema_version": "1.0",
  "status": "released",
  "statuses": [
    "passed",
    "failed",
    "needs-input",
    "blocked"
  ],
  "version": "1.0.0",
  "execution": {
    "adapter": "workspace",
    "tools": [
      "read",
      "grep",
      "find",
      "ls",
      "bash",
      "edit",
      "write",
      "run-tests"
    ],
    "mutation": "isolated-worktree",
    "authorization": {
      "required": true,
      "scopes": [
        "workspace-write"
      ]
    },
    "correction_inputs": [
      "Correction feedback"
    ]
  }
}
