{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-hub.local/slots/schema.json",
  "title": "Capability Compiler Slot Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "responsibility",
    "inputs",
    "outputs",
    "boundaries",
    "dependencies",
    "permissions",
    "statuses",
    "gates",
    "forbidden_actions",
    "hard_failures",
    "artifact_types"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
    "status": {"enum": ["draft", "evaluating", "released"]},
    "responsibility": {"type": "string", "minLength": 1},
    "inputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "outputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "output": {"type": "string", "minLength": 1}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {
          "oneOf": [
            {"const": "none"},
            {"$ref": "#/$defs/nonEmptyStrings"}
          ]
        },
        "requires_explicit_authorization": {"type": "boolean"},
        "explicitly_denied": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "statuses": {"$ref": "#/$defs/nonEmptyStrings"},
    "gates": {"$ref": "#/$defs/nonEmptyStrings"},
    "forbidden_actions": {"$ref": "#/$defs/nonEmptyStrings"},
    "hard_failures": {"$ref": "#/$defs/nonEmptyStrings"},
    "artifact_types": {"$ref": "#/$defs/nonEmptyStrings"}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
