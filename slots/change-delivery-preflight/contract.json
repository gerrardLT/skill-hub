{
  "artifact_types": [
    "SKILL.md",
    "contract.json",
    "provenance.json"
  ],
  "boundaries": {
    "input": "A reviewed change, repository state, delivery policy, and intended publication boundary.",
    "output": "A delivery-ready package or explicit preflight blockers; no merge or deployment action."
  },
  "dependencies": [],
  "forbidden_actions": [
    "claim purification or release",
    "execute without required permissions and evidence",
    "fabricate or infer missing evidence"
  ],
  "gates": [
    "evidence-present",
    "unknowns-preserved",
    "authority-boundary",
    "responsibility-boundary"
  ],
  "hard_failures": [
    "missing-source-evidence",
    "missing-required-permission",
    "unresolved-dependency",
    "fabricated-evidence",
    "incorrect-gate-pass"
  ],
  "id": "change-delivery-preflight",
  "inputs": [
    "change-artifact",
    "completion-evidence",
    "qa-verdict",
    "repository-state",
    "delivery-policy",
    "delivery-authorization",
    "Correction feedback"
  ],
  "outputs": [
    "release-package"
  ],
  "permissions": {
    "default": [
      "read",
      "grep",
      "find",
      "ls",
      "bash"
    ],
    "requires_explicit_authorization": false,
    "explicitly_denied": [
      "remote-git",
      "network",
      "merge",
      "deploy"
    ]
  },
  "responsibility": "Prepare a verified change for delivery by checking branch state, merge base, credentials, automation stops, and documentation invariants.",
  "schema_version": "1.0",
  "status": "released",
  "statuses": [
    "passed",
    "failed",
    "needs-input",
    "blocked"
  ],
  "version": "1.0.0",
  "execution": {
    "adapter": "workspace",
    "tools": [
      "read",
      "grep",
      "find",
      "ls",
      "bash"
    ],
    "mutation": "none",
    "authorization": {
      "required": false,
      "scopes": []
    },
    "correction_inputs": [
      "Correction feedback"
    ]
  }
}
