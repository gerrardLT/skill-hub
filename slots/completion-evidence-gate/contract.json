{
  "artifact_types": [
    "SKILL.md",
    "contract.json",
    "provenance.json"
  ],
  "boundaries": {
    "input": "A proposed status claim and the command capable of proving it.",
    "output": "An evidence-supported conclusion or an explicit failure, never confidence or delegated self-report."
  },
  "dependencies": [],
  "forbidden_actions": [
    "claim purification or release",
    "execute without required permissions and evidence",
    "fabricate or infer missing evidence"
  ],
  "gates": [
    "evidence-present",
    "unknowns-preserved",
    "authority-boundary",
    "responsibility-boundary"
  ],
  "hard_failures": [
    "missing-source-evidence",
    "missing-required-permission",
    "unresolved-dependency",
    "fabricated-evidence",
    "incorrect-gate-pass"
  ],
  "id": "completion-evidence-gate",
  "inputs": [
    "A proposed status claim and the command capable of proving it."
  ],
  "outputs": [
    "An evidence-supported conclusion or an explicit failure, never confidence or delegated self-report."
  ],
  "permissions": {
    "default": [
      "read",
      "grep",
      "find",
      "ls",
      "bash",
      "run-tests"
    ],
    "requires_explicit_authorization": false,
    "explicitly_denied": [
      "remote-git",
      "network",
      "merge",
      "deploy"
    ]
  },
  "responsibility": "Require a fresh complete command, output inspection, and exit-code check before any success or completion claim.",
  "schema_version": "1.0",
  "status": "released",
  "statuses": [
    "passed",
    "failed",
    "needs-input",
    "blocked"
  ],
  "version": "1.0.0",
  "execution": {
    "adapter": "workspace",
    "tools": [
      "read",
      "grep",
      "find",
      "ls",
      "bash",
      "run-tests"
    ],
    "mutation": "none",
    "authorization": {
      "required": false,
      "scopes": []
    },
    "correction_inputs": [
      "Correction feedback"
    ]
  }
}
