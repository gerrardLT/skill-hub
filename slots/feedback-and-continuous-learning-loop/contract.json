{
  "artifact_types": [
    "SKILL.md",
    "contract.json",
    "provenance.json"
  ],
  "boundaries": {
    "input": "Runtime metrics, customer feedback, experiment results, alerts, and residual assumptions.",
    "output": "A review cadence, learning record, calibrated hypotheses, priorities, and the next discovery input."
  },
  "dependencies": [],
  "forbidden_actions": [
    "claim purification or release",
    "execute without required permissions and evidence",
    "fabricate or infer missing evidence"
  ],
  "gates": [
    "evidence-present",
    "unknowns-preserved",
    "authority-boundary",
    "responsibility-boundary"
  ],
  "hard_failures": [
    "missing-source-evidence",
    "missing-required-permission",
    "unresolved-dependency",
    "fabricated-evidence",
    "incorrect-gate-pass"
  ],
  "id": "feedback-and-continuous-learning-loop",
  "inputs": [
    "expected-outcomes",
    "actual-results",
    "delivery-evidence",
    "decisions",
    "feedback",
    "Correction feedback"
  ],
  "outputs": [
    "next-requirements"
  ],
  "permissions": {
    "default": [
      "read-local-files",
      "write-run-output"
    ],
    "requires_explicit_authorization": false,
    "explicitly_denied": [
      "remote-git",
      "network",
      "merge",
      "deploy"
    ]
  },
  "responsibility": "Maintain customer contact, feedback synthesis, metric review, calibration, and the next learning cycle.",
  "schema_version": "1.0",
  "status": "released",
  "statuses": [
    "passed",
    "failed",
    "needs-input",
    "blocked"
  ],
  "version": "1.0.0",
  "execution": {
    "adapter": "artifact",
    "tools": [],
    "mutation": "run-output",
    "authorization": {
      "required": false,
      "scopes": []
    },
    "correction_inputs": [
      "Correction feedback"
    ]
  }
}
