{
  "artifact_types": [
    "SKILL.md",
    "contract.json",
    "provenance.json"
  ],
  "boundaries": {
    "input": "Product facts, a brief, design assets, tokens, components, surface context, and references.",
    "output": "A design read, selected direction, constraints, spatial thesis, and auditable direction contract."
  },
  "dependencies": [],
  "forbidden_actions": [
    "claim purification or release",
    "execute without required permissions and evidence",
    "fabricate or infer missing evidence"
  ],
  "gates": [
    "evidence-present",
    "unknowns-preserved",
    "authority-boundary",
    "responsibility-boundary"
  ],
  "hard_failures": [
    "missing-source-evidence",
    "missing-required-permission",
    "unresolved-dependency",
    "fabricated-evidence",
    "incorrect-gate-pass"
  ],
  "id": "design-context-and-direction-contract",
  "inputs": [
    "requirements-artifact",
    "acceptance-criteria-artifact",
    "design-authority",
    "project-context",
    "Correction feedback"
  ],
  "outputs": [
    "design-contract"
  ],
  "permissions": {
    "default": [
      "read-local-files",
      "write-run-output"
    ],
    "requires_explicit_authorization": false,
    "explicitly_denied": [
      "remote-git",
      "network",
      "merge",
      "deploy"
    ]
  },
  "responsibility": "Read product and visual authority and define the audience, surface mode, direction, and design contract.",
  "schema_version": "1.0",
  "status": "released",
  "statuses": [
    "passed",
    "failed",
    "needs-input",
    "blocked"
  ],
  "version": "1.0.0",
  "execution": {
    "adapter": "artifact",
    "tools": [],
    "mutation": "run-output",
    "authorization": {
      "required": false,
      "scopes": []
    },
    "correction_inputs": [
      "Correction feedback"
    ]
  }
}
