  "conflict_edges": [
    {
      "edge_id": "X1",
      "conflict": "qa-only 'NEVER fix anything' vs systematic-debugging 'fix root cause'",
      "skills": ["qa-only 规则 11", "systematic-debugging Phase 4"],
      "nature": "角色边界冲突而非逻辑矛盾：qa-only 是纯报告角色，/qa 才是测试-修复闭环",
      "resolution": "在 dev-loop 路由层显式分流：验收步骤默认 qa-only（只报告）；修复指令路由到实现域调试流程。两个角色不共存于同一次调用",
      "severity": "routing-level"
    },
    {
      "edge_id": "X2",
      "conflict": "gstack Checkpoint Mode 'WIP auto-commit' vs TDD 'delete means delete'",
      "skills": ["gstack preamble (WIP: 前缀自动提交)", "test-driven-development 铁律"],
      "nature": "流程冲突：WIP 检查点会提交中间态（含未通过测试的实现），TDD 视先代码后测试为必须删除的违规",
      "resolution": "WIP 提交仅限'完成的功能单元'（gstack 规则原文：commit after completed functions），TDD 违规产物不满足该条件故不触发 WIP；ship 压缩 WIP 时亦不保护 TDD 违规代码。规则原文已兼容，提纯时保留两边的原始措辞以防误读",
      "severity": "apparent-only"
    },
    {
      "edge_id": "X3",
      "conflict": "test-case-generator 5 维等权评分 vs qa-only 8 类加权评分",
      "skills": ["test-case-generator quality_score", "qa-only Health Score Rubric"],
      "nature": "度量口径不一致：用例质量（覆盖率/可执行性/独立性/可维护性/完备性 各 20%）与应用健康度（Functional 20%/Console 15%...）是两个不同对象的评分，但'覆盖率'术语在两边语义不同",
      "resolution": "提纯时明确区分两个度量对象：case-quality-score（用例文档质量）与 app-health-score（运行时应用质量）；禁止跨对象复用分数",
      "severity": "terminology-level"
    }
  ],
