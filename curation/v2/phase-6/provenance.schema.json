    "source_fragment_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "evaluating"
    },
    "version": {
      "const": "0.1.0-v2-candidate"
    }
