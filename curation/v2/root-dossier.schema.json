{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Compiler V2 root dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root_id",
    "skill_path",
    "source_sha256",
    "trigger",
    "non_trigger",
    "responsibility",
    "non_responsibility",
    "inputs",
    "outputs",
    "workflow",
    "branches",
    "rules_gates",
    "stop_conditions",
    "tools_dependencies",
    "permissions_side_effects",
    "unique_methods",
    "weaknesses_failure_modes",
    "relationship_hypotheses",
    "source_citations",
    "support_file_reviews"
  ],
  "properties": {
    "root_id": {"type": "string", "pattern": "^skill-root:.+"},
    "skill_path": {"type": "string", "pattern": "^[^/].*/SKILL\\.md$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trigger": {"type": "string", "minLength": 1},
    "non_trigger": {"type": "string", "minLength": 1},
    "responsibility": {"type": "string", "minLength": 1},
    "non_responsibility": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "workflow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "branches": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rules_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tools_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "permissions_side_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unique_methods": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "weaknesses_failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "relationship_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target", "claim", "evidence"],
        "properties": {
          "type": {"enum": ["duplicate", "complementary", "conditional-variant", "conflict", "strong-dependency"]},
          "target": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "source_citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line_start", "line_end"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1}
        }
      }
    },
    "support_file_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "disposition", "reason", "evidence"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["semantic-read", "behavior-reviewed", "excluded"]},
          "reason": {"type": ["string", "null"]},
          "subkind": {"type": ["string", "null"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "matched_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
