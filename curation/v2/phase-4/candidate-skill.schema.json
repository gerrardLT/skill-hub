{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_types": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "capability_id": {
      "pattern": "^capability:",
      "type": "string"
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "external": {
          "enum": [
            "none",
            "read-only"
          ]
        },
        "host_actions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "model_tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "mutation_scope": {
          "enum": [
            "run-output",
            "authorized-workspace",
            "artifact-output"
          ]
        },
        "remote_write": {
          "const": false
        }
      },
      "required": [
        "model_tools",
        "host_actions",
        "external",
        "mutation_scope",
        "remote_write"
      ],
      "type": "object"
    },
    "forbidden_actions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "hard_gates": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "type": "string"
    },
    "inputs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "outputs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "permission_identity": {
      "enum": [
        "workspace-write",
        "artifact-write-local-exec-external-read"
      ]
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "human_decision": {
          "type": "boolean"
        },
        "rendered_evidence": {
          "type": "boolean"
        },
        "review_source_separation": {
          "const": true
        }
      },
      "required": [
        "human_decision",
        "rendered_evidence",
        "review_source_separation",
        "coverage"
      ],
      "type": "object"
    },
    "responsibility": {
      "minLength": 20,
      "type": "string"
    },
    "schema_version": {
      "const": "2.0"
    },
    "status": {
      "const": "evaluating"
    },
    "statuses": {
      "const": [
        "passed",
        "needs-input",
        "blocked",
        "failed"
      ]
    },
    "version": {
      "const": "0.1.0-v2-candidate"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "capability_id",
    "responsibility",
    "inputs",
    "outputs",
    "permission_identity",
    "statuses",
    "hard_gates",
    "forbidden_actions",
    "artifact_types",
    "execution",
    "policy"
  ],
  "type": "object"
}
