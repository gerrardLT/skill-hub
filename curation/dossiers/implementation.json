    {"name": "executing-plans", "role": "流程：按计划逐项执行"},
    {"name": "subagent-driven-development", "role": "流程：子代理分工执行"},
    {"name": "code-review", "role": "质量门：实现后审查"},
    {"name": "requesting-code-review", "role": "流程：发起审查请求"},
    {"name": "verification-before-completion", "role": "质量门：完成前验证"},
    {"name": "writing-plans", "role": "上游：实现计划编写"}
