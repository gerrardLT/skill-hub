{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic SDLC Gate Result",
  "type": "object",
  "required": [
    "gate",
    "status",
    "checked_at",
    "missing_artifacts",
    "blocking_critical_risks"
  ],
  "properties": {
    "gate": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "waived"
      ]
    },
    "checked_at": {
      "type": "string"
    },
    "missing_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_critical_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approver": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "expires": {
      "type": "string"
    },
    "invalid_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "duplicate_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "distinct_source_count": {
      "type": "integer"
    },
    "evidence_target_count": {
      "type": "integer"
    },
    "trace_coverage": {
      "type": "number"
    },
    "state_snapshot": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "compensating_control": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "lite",
        "standard",
        "high-assurance"
      ]
    },
    "criticality": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "trace_path_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "minimum_trace_path_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trace_path_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "upstream_invalidations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
