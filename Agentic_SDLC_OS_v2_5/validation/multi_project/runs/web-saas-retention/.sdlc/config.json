{
  "schema_version": "2.5.0",
  "gate_policy": "strict",
  "allow_waiver": true,
  "max_waiver_days": 14,
  "allow_force_transition": true,
  "force_requires_human_approval": true,
  "waiver_requires_approver": true,
  "artifact_status_required_for_gates": "accepted",
  "gate_artifact_min_bytes": 64,
  "gate_require_integrity": true,
  "stage_policy": "adjacent",
  "evidence_deduplicate": true,
  "process_profile": "standard",
  "audit_chain": true,
  "artifact_contract_enforcement": true,
  "independent_verification": "risk-based",
  "cost_budget_usd": 25.0,
  "token_budget": 500000,
  "budget_hard_enforcement": false,
  "domain_packs": [
    "saas"
  ],
  "domain_required_controls": [
    "tenant-isolation",
    "authorization-matrix",
    "billing-idempotency",
    "data-export-and-deletion",
    "backup-restore-test",
    "slo-and-error-budget",
    "audit-log-retention",
    "migration-rehearsal"
  ],
  "domain_required_artifacts": [
    "tenant-isolation-design",
    "authorization-matrix",
    "billing-state-machine",
    "slo-spec",
    "backup-restore-report"
  ],
  "domain_required_evidence": [
    "cross-tenant-negative-tests",
    "billing-reconciliation",
    "restore-drill",
    "slo-dashboard"
  ],
  "domain_gate_overlays": {
    "build-ready": [
      "tenant-isolation-design",
      "authorization-matrix"
    ],
    "production-ready": [
      "backup-restore-report",
      "slo-spec"
    ]
  },
  "domain_risk_adjustment": 2.0,
  "domain_budget_multiplier": 1.1,
  "auto_tailoring": {
    "profile": "standard",
    "risk_score": 26.0,
    "hard_escalations": [],
    "required_controls": [
      "state-integrity",
      "evidence-ledger",
      "traceability",
      "code-review",
      "automated-tests",
      "rollback-plan",
      "runtime-observability"
    ],
    "optional_controls": [
      "formal-threat-model",
      "migration-rehearsal",
      "chaos-test"
    ],
    "minimum_independent_reviewers": 1,
    "rationale": [
      "Highest risk factors: problem_uncertainty=4, user_exposure=3, blast_radius=2",
      "Domain risk adjustment: +2.0"
    ],
    "factors": {
      "blast_radius": 2,
      "data_sensitivity": 2,
      "regulatory_exposure": 1,
      "irreversibility": 1,
      "technical_novelty": 2,
      "problem_uncertainty": 4,
      "user_exposure": 3,
      "change_size": 2,
      "operational_complexity": 2
    }
  }
}
