@@ -0,0 +1,115 @@
+import math
+import time
+from dataclasses import dataclass
+
+from fastapi import Request
+from fastapi.responses import JSONResponse
+from starlette.middleware.base import BaseHTTPMiddleware
+
+
+@dataclass
+class _Window:
+    count: int
+    ends_at: float
+
+
+@dataclass
+class _Limit:
+    limit: int
+    window: _Window
+    conversation: bool
+
+    @property
+    def remaining(self) -> int:
+        return max(self.limit - self.window.count, 0)
+
+
+def _select(limits: list[_Limit]) -> _Limit:
+    return min(
+        limits,
+        key=lambda item: (
+            item.remaining / item.limit,
+            item.window.ends_at,
+            0 if item.conversation else 1,
+        ),
+    )
+
+
+class RateLimitMiddleware(BaseHTTPMiddleware):
+    def __init__(
+        self,
+        app,
+        *,
+        global_per_minute: int = 30,
+        conversation_per_hour: int = 10,
+        excluded_paths: set[str] | None = None,
+    ) -> None:
+        super().__init__(app)
+        if global_per_minute < 1 or conversation_per_hour < 1:
+            raise ValueError("rate-limit thresholds must be positive")
+        self.global_per_minute = global_per_minute
+        self.conversation_per_hour = conversation_per_hour
+        self.excluded_paths = excluded_paths or {"/healthz", "/metrics"}
+        self.global_windows: dict[str, _Window] = {}
+        self.conversation_windows: dict[str, _Window] = {}
+
+    @staticmethod
+    def _increment(windows: dict[str, _Window], key: str, duration: int, now: float) -> _Window:
+        window = windows.get(key)
+        if window is None or now >= window.ends_at:
+            window = windows[key] = _Window(count=0, ends_at=now + duration)
+        window.count += 1
+        return window
+
+    @staticmethod
+    def _headers(limit: _Limit) -> dict[str, str]:
+        return {
+            "X-RateLimit-Limit": str(limit.limit),
+            "X-RateLimit-Remaining": str(limit.remaining),
+            "X-RateLimit-Reset": str(int(limit.window.ends_at)),
+        }
+
+    async def dispatch(self, request: Request, call_next):
+        if request.url.path in self.excluded_paths:
+            return await call_next(request)
+
+        now = time.time()
+        client_ip = request.client.host
+        global_limit = _Limit(
+            self.global_per_minute,
+            self._increment(self.global_windows, client_ip, 60, now),
+            False,
+        )
+        limits = [global_limit]
+        path = request.url.path.split("/")
+        if (
+            request.method == "POST"
+            and len(path) == 5
+            and path[1:3] == ["v2", "conversation"]
+            and path[3]
+            and path[4] == "message"
+        ):
+            limits.append(
+                _Limit(
+                    self.conversation_per_hour,
+                    self._increment(self.conversation_windows, client_ip, 3600, now),
+                    True,
+                )
+            )
+
+        rejected = [limit for limit in limits if limit.window.count > limit.limit]
+        selected = _select(rejected or limits)
+        headers = self._headers(selected)
+        if rejected:
+            return JSONResponse(
+                status_code=429,
+                content={
+                    "detail": "请求过于频繁，请稍后再试",
+                    "retry_after": math.ceil(max(0, selected.window.ends_at - now)),
+                },
+                headers=headers,
+            )
+
+        response = await call_next(request)
+        response.headers.update(headers)
+        return response
