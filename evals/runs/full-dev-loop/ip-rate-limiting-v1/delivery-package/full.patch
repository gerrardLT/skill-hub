diff --git a/apps/api/tests/test_ip_rate_limit_eval.py b/apps/api/tests/test_ip_rate_limit_eval.py
new file mode 100644
index 0000000..36d396e
--- /dev/null
+++ b/apps/api/tests/test_ip_rate_limit_eval.py
@@ -0,0 +1,159 @@
+from pathlib import Path
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from app.core.config import Settings
+from app.core.rate_limit import RateLimitMiddleware
+
+
+def make_app(*, global_limit: int = 30, conversation_limit: int = 10) -> FastAPI:
+    app = FastAPI()
+    app.add_middleware(
+        RateLimitMiddleware,
+        global_per_minute=global_limit,
+        conversation_per_hour=conversation_limit,
+        excluded_paths={"/healthz", "/metrics"},
+    )
+
+    @app.get("/")
+    def root():
+        return {"ok": True}
+
+    @app.post("/v2/conversation/{session_id}/message")
+    def message(session_id: str):
+        return {"session_id": session_id}
+
+    @app.post("/v2/conversation/{path:path}/message")
+    def nested_message(path: str):
+        return {"path": path}
+
+    @app.get("/healthz")
+    def health():
+        return {"ok": True}
+
+    @app.get("/metrics")
+    def metrics():
+        return {"ok": True}
+
+    return app
+
+
+def client(*, global_limit: int = 30, conversation_limit: int = 10, host: str = "testclient") -> TestClient:
+    return TestClient(make_app(global_limit=global_limit, conversation_limit=conversation_limit), client=(host, 50000))
+
+
+def assert_rate_headers(response) -> None:
+    assert response.headers["X-RateLimit-Limit"]
+    assert response.headers["X-RateLimit-Remaining"]
+    assert response.headers["X-RateLimit-Reset"]
+
+
+def test_global_limit_rejects_request_after_configured_threshold() -> None:
+    api = client(global_limit=2)
+    assert api.get("/").status_code == 200
+    second = api.get("/")
+    assert second.status_code == 200
+    assert_rate_headers(second)
+    rejected = api.get("/")
+    assert rejected.status_code == 429
+    assert rejected.json()["detail"] == "请求过于频繁，请稍后再试"
+    assert rejected.json()["retry_after"] >= 0
+    assert_rate_headers(rejected)
+
+
+def test_conversation_limit_is_separate_and_configurable() -> None:
+    api = client(global_limit=100, conversation_limit=2)
+    path = "/v2/conversation/demo/message"
+    assert api.post(path).status_code == 200
+    assert api.post(path).status_code == 200
+    rejected = api.post(path)
+    assert rejected.status_code == 429
+    assert rejected.json()["detail"] == "请求过于频繁，请稍后再试"
+    assert_rate_headers(rejected)
+
+
+def test_health_and_metrics_are_exempt() -> None:
+    api = client(global_limit=1)
+    assert api.get("/").status_code == 200
+    assert api.get("/").status_code == 429
+    for _ in range(3):
+        for path in ("/healthz", "/metrics"):
+            response = api.get(path)
+            assert response.status_code == 200
+            assert not any(name.lower().startswith("x-ratelimit-") for name in response.headers)
+
+
+def test_nested_message_path_uses_only_global_limit() -> None:
+    api = client(global_limit=100, conversation_limit=1)
+    path = "/v2/conversation/a/nested/message"
+    assert api.post(path).status_code == 200
+    assert api.post(path).status_code == 200
+
+
+def test_x_forwarded_for_does_not_change_identity() -> None:
+    api = client(global_limit=1, host="203.0.113.10")
+    assert api.get("/", headers={"X-Forwarded-For": "198.51.100.1"}).status_code == 200
+    assert api.get("/", headers={"X-Forwarded-For": "198.51.100.2"}).status_code == 429
+
+
+def test_distinct_asgi_hosts_have_independent_state() -> None:
+    app = make_app(global_limit=1)
+    first = TestClient(app, client=("203.0.113.20", 50000))
+    second = TestClient(app, client=("203.0.113.21", 50000))
+    assert first.get("/").status_code == 200
+    assert first.get("/").status_code == 429
+    assert second.get("/").status_code == 200
+
+
+def test_rejected_conversation_attempt_counts_globally() -> None:
+    api = client(global_limit=3, conversation_limit=1)
+    path = "/v2/conversation/demo/message"
+    assert api.post(path).status_code == 200
+    assert api.post(path).status_code == 429
+    assert api.get("/").status_code == 200
+    assert api.get("/").status_code == 429
+
+
+def test_headers_select_tightest_limit_and_retry_metadata(monkeypatch) -> None:
+    monkeypatch.setattr("app.core.rate_limit.time.time", lambda: 1000.0)
+    api = client(global_limit=2, conversation_limit=4)
+    first = api.post("/v2/conversation/demo/message")
+    assert first.headers["X-RateLimit-Limit"] == "2"
+    assert first.headers["X-RateLimit-Remaining"] == "1"
+    assert first.headers["X-RateLimit-Reset"] == "1060"
+    second = api.post("/v2/conversation/demo/message")
+    assert second.status_code == 200
+    rejected = api.post("/v2/conversation/demo/message")
+    assert rejected.status_code == 429
+    assert rejected.json()["retry_after"] == 60
+
+
+def test_fixed_window_recovers_after_expiry(monkeypatch) -> None:
+    now = {"value": 1000.0}
+    monkeypatch.setattr("app.core.rate_limit.time.time", lambda: now["value"])
+    api = client(global_limit=1)
+    assert api.get("/").status_code == 200
+    assert api.get("/").status_code == 429
+    now["value"] = 1060.0
+    assert api.get("/").status_code == 200
+
+
+def test_thresholds_are_configurable_from_environment(monkeypatch) -> None:
+    monkeypatch.setenv("RATE_LIMIT_CONVERSATION_PER_HOUR", "7")
+    monkeypatch.setenv("RATE_LIMIT_GLOBAL_PER_MINUTE", "13")
+    settings = Settings()
+    assert settings.rate_limit_conversation_per_hour == 7
+    assert settings.rate_limit_global_per_minute == 13
+
+
+def test_application_wires_rate_limit_middleware() -> None:
+    source = (Path(__file__).parents[1] / "app/main.py").read_text(encoding="utf-8")
+    assert "RateLimitMiddleware" in source
+    assert "rate_limit_global_per_minute" in source
+    assert "rate_limit_conversation_per_hour" in source
+
+
+def test_mvp_has_no_redis_dependency() -> None:
+    pyproject = (Path(__file__).parents[1] / "pyproject.toml").read_text(encoding="utf-8")
+    assert "redis" not in pyproject.casefold()
