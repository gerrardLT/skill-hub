    "plan_all_required_steps": true,
    "sequences": [
      {
        "condition": "no source repair is required after critique",
        "execution_stop": "explicit-human-approval",
        "planned_route": [
          "review-evidence",
          "rendered-critique",
          "explicit-human-approval",
          "release-gate"
        ]
      },
      {
        "condition": "source repair is accepted",
        "execution_stop": "explicit-human-approval",
        "planned_route": [
          "review-evidence",
          "rendered-critique",
          "explicit-human-approval",
          "separate-remediation-capability",
          "review-evidence",
          "rendered-critique",
          "explicit-human-approval",
          "release-gate"
        ]
      }
    ]
  },
  "control_points": [
    {
      "condition": "a reviewer finding, prototype choice, residual risk, remediation scope, or release disposition requires a named human owner decision",
      "executable": false,
      "id": "explicit-human-approval",
      "mutation_scope": "none",
      "outputs": [
        "decision owner",
        "accepted or rejected finding",
        "bounded remediation authorization or disposition",
        "decision evidence"
      ],
      "permission_identity": "human-decision-only"
    },
    {
      "condition": "a human accepted a finding and separately authorized an exact source repair scope",
      "executable": false,
      "id": "separate-remediation-capability",
      "mutation_scope": "none",
      "outputs": [
        "exact remediator capability identity",
        "bounded source scope",
        "stale evidence invalidation",
        "required recapture handoff"
      ],
      "permission_identity": "route-only"
    }
  ],
