  "gates": [
    "every active step has satisfied prerequisites and a compatible permission identity",
    "review and evidence steps cannot mutate product source",
    "static source inspection cannot satisfy rendered evidence",
    "all required UI states, viewports, accessibility, content, motion, and AI branches are explicitly applied or marked not applicable with rationale",
    "final release disposition remains human-owned",
    "human approval is a non-executable control point and never grants the reviewer source-write authority",
    "accepted findings route to a separate remediator identity; repaired UI invalidates stale evidence and must be recaptured",
    "complete route planning lists the required post-decision release-gate while actual execution stops at explicit-human-approval until the named human decision exists"
  ],
  "human_checkpoints": [
    "approve unresolved visual direction and taste choices before production promotion",
    "select a prototype variant before promotion when variants are used",
    "authorize source remediation separately from every review finding",
    "accept residual risk and make the final release disposition"
