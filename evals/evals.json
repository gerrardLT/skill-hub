  "splits": {
    "tuning": "cases/tuning/requirements-to-ac.json",
    "holdout": "cases/holdout/requirements-to-ac.json"
  },
  "baseline": {
    "required": true,
    "entry_root": "runs/requirements-to-ac/baseline",
    "must_record": ["case_id", "source_skill", "full_output", "tool_evidence", "model", "input_hash", "tool_permissions", "budget", "duration_ms", "token_usage", "exit_status", "failure_reason"],
    "failure_policy": "Record failed baseline runs as evidence; do not replace, retry selectively, or omit them from the report."
  },
  "candidate": {
    "entry_root": "runs/requirements-to-ac/iteration-1",
    "not_created": true,
    "freeze_before_holdout": true
  },
  "scoring": {
    "automatic": ["hard_failure_scan", "required_case_fields", "status_match", "unknown_preservation", "acceptance_criteria_observability", "source_traceability"],
    "human": ["evidence-traceability", "problem-and-user-boundary", "requirements-completeness", "acceptance-testability", "uncertainty-and-gates", "scope-and-permission-discipline", "downstream-handoff-quality"],
    "holdout_isolation": true
  },
  "mutation_plan": {
    "required_after_candidate_freeze": true,
    "mutations": [
      "remove evidence-insufficiency rule",
      "remove unknown marker requirement",
      "remove acceptance-criteria field",
      "replace blocked gate with pass",
      "add unsupported implementation commitment"
    ],
    "expected": "Each mutation causes the corresponding objective or hard-failure check to fail."
  },
  "status": "contracts-frozen-baseline-not-run"
}
